\begin_layout Standard
ריכוז התמיסה קובע את זמינות היונים - אשר בתורם 
\begin_inset Quotes qld
\end_inset

מזינים
\begin_inset Quotes qrd
\end_inset

 את החזית ודרכה את אופי הגדילה של הצביר.
 בריכוז נמוך ההובלה דיפוזיבית בעיקרה וישנה מידה רבה של מיסוך (התנאים הקרובים ביותר ל-
\begin_inset Formula $\text{DLA}$
\end_inset

 אידיאלי).
 עם עליית הריכוז נחלש המיסוך בין ענפים שכנים,
 ומתחילים להופיע מנגנוני הובלה נוספים - נדידה (
\begin_inset Formula $\text{migration}$
\end_inset

) בשדה החשמלי והסעה (
\begin_inset Formula $\text{convection}$
\end_inset

) המתחרים בדיפוזיה וממלאים את החלל שבין הענפים;
 מתקבל מבנה צפוף שממדו האפקטיבי שואף לממד המישור,
 
\begin_inset Formula $D\rightarrow2$
\end_inset

,
 ולצדו חזית גדילה מהירה.
 מכך שהמדידה בריכוז הנמוך ביותר 
\begin_inset Formula $\left(0.02\%\right)$
\end_inset

 היא המבחן ההוגן ביותר לערך התיאורטי 
\begin_inset Formula $1.71$
\end_inset

 של 
\begin_inset Formula $\text{DLA}$
\end_inset

 דו-ממדי.
 בניסוי נמדדו,
 כתלות בריכוז התמיסה:
 רדיוס המעגל החוסם את הצביר 
\begin_inset Formula $R\left(t\right)$
\end_inset

,
 קצב הגדילה הממוצע 
\begin_inset Formula $\left\langle \frac{dR}{dt}\right\rangle $
\end_inset

,
 צפיפות הצביר 
\begin_inset Formula $\phi=M/\pi R^{2}$
\end_inset

 (כאשר 
\begin_inset Formula $M$
\end_inset

 שטח המשקע),
 והממד הפרקטלי 
\begin_inset Formula $D$
\end_inset

.
\end_layout

