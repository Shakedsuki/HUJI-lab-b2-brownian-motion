\begin_layout Standard

\series bold
מודל ממוצע ריבוע ההעתק ורעש מדידה
\end_layout

\begin_layout Standard
המודל המקובל לממוצע ריבוע ההעתק הוא 
\begin_inset Formula $\left\langle r^{2}\right\rangle =4Dt$
\end_inset

 כפי שהוסבר במבוא.
 אך במדידות המיקומים במערכת זאת קיימים רעשים במדידת המיקום של החלקיקים.
 היות ואנו לא "באמת" יודעים מהו מרכז החלקיקים שאנו מודדים,
 כל מיקום נמדד נושא איתו שגיאה אקראית הנובעת משיקולים אופטיים (כגון עקיפה),
 רעשים ברמת הפיקסל,
 וכדומה.
 
\end_layout

\begin_layout Standard
אם נסמן את אותה שגיאה אקראית בציר 
\begin_inset Formula $x$
\end_inset

 ב-
\begin_inset Formula $\varepsilon_{x}$
\end_inset

,
 אזי מיקום החלקיק שאנחנו מודדים הינו הלכה למעשה 
\begin_inset Formula $x_{meas}=x_{true}+\varepsilon_{x}$
\end_inset

,
 ומכאן שמדידת המיקום לאורך צעדי הזמן הינה 
\begin_inset Formula $\Delta x_{meas}=\Delta x_{true}+\Delta\varepsilon_{x}$
\end_inset

.
 נוכל לראות כי כאשר נעלה הביטוי בריבוע ונמצע נקבל:
\begin_inset Formula 
\begin{equation}
\left\langle \Delta x_{meas}^{2}\right\rangle =\left\langle \Delta x_{true}^{2}\right\rangle +2\cancelto{0}{\left\langle \Delta x_{true}\Delta\varepsilon_{x}\right\rangle }+\left\langle \Delta\varepsilon_{x}^{2}\right\rangle =\left\langle \Delta x_{true}^{2}\right\rangle +\left\langle \Delta\varepsilon_{x}^{2}\right\rangle 
\end{equation}

\end_inset

 כאשר האיבר המעורב מתאפס בשל חוסר התלות הסטטיסטית בין התנועה לרעש המדידה,
 והתאפסות תוחלת הרעש 
\begin_inset Formula $\left\langle \Delta x_{true}\Delta\varepsilon_{x}\right\rangle =\left\langle \Delta x_{true}\right\rangle \left\langle \Delta\varepsilon_{x}\right\rangle =0$
\end_inset

.
 נרחיב זאת לדו-ממד ונקבל:
\begin_inset Formula 
\begin{equation}
\left\langle r_{meas}^{2}\right\rangle =\underbrace{\left\langle \Delta x_{meas}^{2}\right\rangle }_{2Dt+\left\langle \Delta\varepsilon_{x}^{2}\right\rangle }+\underbrace{\left\langle \Delta y_{meas}^{2}\right\rangle }_{2Dt+\left\langle \Delta\varepsilon_{y}^{2}\right\rangle }=4Dt+\left\langle \Delta\varepsilon_{x}^{2}\right\rangle +\left\langle \Delta\varepsilon_{y}^{2}\right\rangle 
\end{equation}

\end_inset

 מכיוון שהרעש איזוטרופי מתקיים 
\begin_inset Formula $\left\langle \Delta\varepsilon_{x}^{2}\right\rangle =\left\langle \Delta\varepsilon_{y}^{2}\right\rangle $
\end_inset

.
 נסמן 
\begin_inset Formula $\frac{1}{2}c\equiv\left\langle \Delta\varepsilon_{x}^{2}\right\rangle =\left\langle \Delta\varepsilon_{y}^{2}\right\rangle $
\end_inset

 ומכאן
\begin_inset Formula 
\begin{equation}
\left\langle r_{meas}^{2}\right\rangle =4Dt+c
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
לכן במקרה שלנו הוספנו אפשרות לקבוע בהתאמות שביצענו.
\end_layout

